-- Owns Cafe | Coffee & More  -  3ds Max build script
-- Generated from Owns_Cafe.dxf (cm) by tools/build_scene.py -> mesher.py -> export.py
-- Use: keep next to the 'textures' folder. 3ds Max: Scripting > Run Script... > this file.
-- Builds every object as a finished mesh with rounded edges, Physical Materials, photometric lights
-- and physical cameras, then saves Owns_Cafe.max next to this script.
(
local scriptDir = getFilenamePath (getSourceFileName())
local texDir = scriptDir + "textures\\"
local matNames = #(), mats = #(), mapSizes = #()
local nObj = 0, nFail = 0

fn sp obj prop val = (try (setProperty obj prop val) catch ())
fn getLayer nm = (
	local l = LayerManager.getLayerFromName nm
	if l == undefined do l = LayerManager.newLayerFromName nm
	l
)
fn newMat nm = (
	local m = undefined
	try (m = PhysicalMaterial name:nm) catch ()
	if m == undefined do try (m = Physical_Material name:nm) catch ()
	if m == undefined do m = StandardMaterial name:nm
	m
)
fn defMat key rgb rough metal texFile mapSize kind lum coat bump = (
	local m = newMat ("OWN_" + key)
	sp m #base_color rgb
	sp m #diffuse rgb
	sp m #roughness rough
	sp m #metalness metal
	if coat > 0 do (sp m #coating coat; sp m #coat_roughness 0.05)
	if texFile != undefined do (
		local b = Bitmaptexture filename:(texDir + texFile) name:(key + "_map")
		sp m #base_color_map b
		sp m #diffuseMap b
		if bump > 0 do (
			local bb = Bitmaptexture filename:(texDir + texFile) name:(key + "_bump")
			sp m #bump_map bb
			sp m #bump_map_amt (bump * 0.3)
		)
	)
	if kind == "glass" or kind == "glass_dark" do (
		sp m #transparency (if kind == "glass" then 1.0 else 0.6)
		sp m #trans_color rgb
		sp m #trans_ior 1.52
		sp m #thin_walled false
		sp m #opacity (if kind == "glass" then 12 else 60)
	)
	if kind == "emit" do (
		sp m #emission 1.0
		sp m #emit_color rgb
		sp m #emit_luminance lum
		sp m #base_color (color 0 0 0)
		sp m #selfIllumAmount 100
	)
	append matNames key; append mats m; append mapSizes mapSize
	m
)
fn mkMesh nm lay mk vs fs = (
	try (
		local m = mesh vertices:vs faces:fs
		m.name = nm
		meshop.autoSmooth m #{1..m.numfaces} 179.0
		update m
		m.pivot = m.center
		local i = findItem matNames mk
		local ms = if i > 0 then mapSizes[i] else 100.0
		addModifier m (Uvwmap maptype:4 length:ms width:ms height:ms)
		if i > 0 do m.material = mats[i]
		(getLayer lay).addNode m
		nObj += 1
		m
	) catch (nFail += 1; format "Owns: could not build % (%)\n" nm (getCurrentException()))
)
fn mkLight nm kind p cd k aim hot fall = (
	local l = undefined
	try (l = Free_Light name:nm pos:p) catch (l = Omnilight name:nm pos:p)
	sp l #useKelvin true
	sp l #kelvin k
	sp l #intensityType 1
	sp l #intensity cd
	case kind of (
		"spot": (sp l #distribution 1; sp l #hotSpot hot; sp l #falloff fall)
		"diffuse": (sp l #distribution 2)
		default: (sp l #distribution 0)
	)
	sp l #castShadows true
	if aim == "up" do rotate l (angleaxis 180 [1,0,0])
	(getLayer "13_Lights").addNode l
	l
)
fn mkCam nm p t mm ev = (
	local tg = Targetobject name:(nm + "_Target") pos:t
	local c = undefined
	try (c = Physical_Camera name:nm pos:p target:tg) catch (c = Targetcamera name:nm pos:p target:tg)
	sp c #focal_length_mm mm
	sp c #auto_vertical_tilt_correction true
	sp c #exposure_gain_type 1
	sp c #exposure_value ev
	if classOf c == Targetcamera do c.fov = 2.0 * atan (18.0 / mm)
	(getLayer "14_Cameras").addNode c
	(getLayer "14_Cameras").addNode tg
	c
)

fn buildAll = (
	local t0 = timeStamp()
	units.SystemType = #Centimeters
	units.DisplayType = #Metric
	units.MetricType = #Centimeters
	disableSceneRedraw()
	-- materials
	defMat "asphalt" (color 38 38 40) 0.9 0 undefined 100 "" 0 0 0
	defMat "bark" (color 90 70 50) 0.9 0 undefined 100 "" 0 0 0
	defMat "brass" (color 214 172 100) 0.28 1 "brass.jpg" 50 "" 0 0 0
	defMat "bulb" (color 255 210 154) 0.5 0 undefined 100 "emit" 8000 0 0
	defMat "ceiling" (color 242 240 234) 0.9 0 undefined 100 "" 0 0 0
	defMat "ceramic" (color 246 246 244) 0.1 0 undefined 100 "" 0 0.5 0
	defMat "curb" (color 176 170 160) 0.9 0 undefined 100 "" 0 0 0
	defMat "door_white" (color 235 231 223) 0.4 0 undefined 100 "" 0 0 0
	defMat "floor" (color 236 231 222) 0.18 0 "floor_tile.jpg" 120 "" 0 0.3 0
	defMat "glass" (color 235 245 243) 0 0 undefined 100 "glass" 0 0 0
	defMat "glass_dark" (color 40 50 56) 0.05 0 undefined 100 "glass_dark" 0 0 0
	defMat "lacquer_white" (color 241 239 234) 0.3 0 undefined 100 "" 0 0 0
	defMat "leaves" (color 78 98 56) 0.6 0 undefined 100 "" 0 0 0
	defMat "led_cool" (color 243 246 255) 0.5 0 undefined 100 "emit" 1500 0 0
	defMat "led_halo" (color 255 200 135) 0.5 0 undefined 100 "emit" 9000 0 0
	defMat "led_hidden" (color 255 196 128) 0.5 0 undefined 100 "emit" 12000 0 0
	defMat "led_warm" (color 255 196 128) 0.5 0 undefined 100 "emit" 6000 0 0
	defMat "metal_black" (color 20 20 20) 0.38 0.7 undefined 100 "" 0 0 0
	defMat "mirror" (color 240 240 240) 0.02 1 undefined 100 "" 0 0 0
	defMat "oak" (color 196 160 118) 0.45 0 "oak.jpg" 100 "" 0 0 0.15
	defMat "paint_yellow" (color 201 162 39) 0.7 0 undefined 100 "" 0 0 0
	defMat "paper" (color 232 224 210) 0.8 0 undefined 100 "" 0 0 0
	defMat "pastry" (color 176 116 58) 0.45 0 undefined 100 "" 0 0 0.6
	defMat "pastry_dark" (color 92 56 32) 0.55 0 undefined 100 "" 0 0 0.6
	defMat "paver" (color 150 143 132) 0.9 0 undefined 100 "" 0 0 0
	defMat "planter" (color 226 219 207) 0.75 0 undefined 100 "" 0 0 0
	defMat "plaster_ext" (color 205 191 174) 0.9 0 undefined 100 "" 0 0 0
	defMat "plaster_sand" (color 214 194 166) 0.85 0 undefined 100 "" 0 0 0
	defMat "plaster_white" (color 239 236 230) 0.85 0 undefined 100 "" 0 0 0
	defMat "quartz" (color 244 241 236) 0.12 0 undefined 100 "" 0 0.4 0
	defMat "screen" (color 60 80 105) 0.05 0 undefined 100 "emit" 60 0 0
	defMat "sign_glow" (color 255 222 170) 0.5 0 undefined 100 "emit" 450 0 0
	defMat "soil" (color 58 43 31) 1 0 undefined 100 "" 0 0 0
	defMat "steel" (color 205 205 205) 0.25 1 undefined 100 "" 0 0 0
	defMat "stone" (color 214 200 180) 0.62 0 "travertine.jpg" 200 "" 0 0 0.35
	-- meshes
	mkMesh "Wall_Left_A" "01_Shell" "stone" #([123.8,278.89,580],[130.33,274.21,580],[130.38,274.18,580],[130.62,274.09,580],[130.73,274.08,580],[130.84,274.1,580],[130.95,274.14,580],[131.15,274.3,580],[131.19,274.35,580],[141.72,289,580],[141.75,289.06,580],[141.89,289.5,580],[141.9,289.57,580],[141.9,548.08,580],[141.89,548.14,580],[141.83,548.39,580],[141.77,548.49,580],[141.69,548.57,580],[141.59,548.63,580],[141.34,548.69,580],[141.28,548.7,580],[124.12,548.7,580],[124.06,548.69,580],[123.81,548.63,580],[123.71,548.57,580],[123.63,548.49,580],[123.57,548.39,580],[123.51,548.14,580],[123.5,548.08,580],[123.5,279.48,580],[123.51,279.42,580],[123.56,279.2,580],[123.61,279.11,580],[123.76,278.93,580],[123.55,278.58,579.89],[130.11,273.87,579.89],[130.22,273.81,579.89],[130.53,273.69,579.89],[130.74,273.67,579.89],[130.96,273.71,579.89],[131.16,273.8,579.89],[131.42,274.01,579.89],[131.5,274.09,579.89],[142.06,288.79,579.89],[142.12,288.91,579.89],[142.28,289.41,579.89],[142.3,289.54,579.89],[142.3,548.11,579.89],[142.28,548.22,579.89],[142.2,548.54,579.89],[142.09,548.73,579.89],[141.93,548.89,579.89],[141.74,549,579.89],[141.42,549.09,579.89],[141.31,549.1,579.89],[124.09,549.1,579.89],[123.98,549.09,579.89],[123.66,549,579.89],[123.47,548.89,579.89],[123.31,548.73,579.89],[123.2,548.54,579.89],[123.11,548.22,579.89],[123.1,548.11,579.89],[123.1,279.46,579.89],[123.11,279.35,579.89],[123.18,279.06,579.89],[123.28,278.88,579.89],[123.47,278.65,579.89],[123.36,278.36,579.6],[129.96,273.62,579.6],[130.09,273.55,579.6],[130.46,273.41,579.6],[130.75,273.38,579.6],[131.05,273.43,579.6],[131.32,273.55,579.6],[131.62,273.8,579.6],[131.72,273.91,579.6],[142.31,288.64,579.6],[142.39,288.8,579.6],[142.56,289.34,579.6],[142.59,289.52,579.6],[142.59,548.13,579.6],[142.57,548.28,579.6],[142.47,548.66,579.6],[142.32,548.91,579.6],[142.11,549.12,579.6],[141.86,549.27,579.6],[141.48,549.37,579.6],[141.33,549.39,579.6],[124.07,549.39,579.6],[123.92,549.37,579.6],[123.54,549.27,579.6]