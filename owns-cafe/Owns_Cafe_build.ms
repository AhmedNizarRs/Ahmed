	mkLight "Light_Car_Headlight_2" "spot" [17.5,359.5,88] 2200 5600 "down" 22 55 aimv:[0,-0.9962,-0.0872]
	-- Car_Nissan_Patrol_2021: Nissan Patrol 2021 by Nieve5677 (Sketchfab, CC-BY-4.0), see car\CREDIT.txt
	try (
		local carFile = scriptDir + "car\\Nissan_Patrol_2021.fbx"
		if doesFileExist carFile do (
			local before = objects as array
			importFile carFile #noPrompt using:FBXIMP
			for o in objects where (findItem before o) == 0 do (
				if o.parent == undefined do o.pos += [-54.5,612,-2]
				(getLayer "15_Car").addNode o
			)
		)
	) catch (format "Owns: car import failed (%)\n" (getCurrentException()))
	-- cameras (physical; exposure value: exterior night ~4, interior ~5.5)
	local cams = #()
	append cams (mkCam "CAM_Exterior_Corner" [-470,-440,165] [190,360,245] 24 4)
	append cams (mkCam "CAM_Exterior_DriveThru" [-560,130,165] [122,640,270] 24 4)
	append cams (mkCam "CAM_Interior_ToPartition" [440,175,150] [290,666,175] 18 5.5)
	append cams (mkCam "CAM_Interior_ToFront" [478,655,160] [225,215,140] 18 5.5)
	append cams (mkCam "CAM_Counter_Bakery" [378,368,132] [318,482,120] 30 5.5)
	backgroundColor = color 10 14 30
	ambientColor = color 0 0 0
	-- night-sky HDRI (Poly Haven, CC0): background + sky light
	try (
		local hd = Bitmaptexture filename:(scriptDir + "hdri\\neuer_zollhof_2k.hdr") name:"Night_City_HDRI"
		hd.coords.mappingType = 1
		hd.coords.mapping = 0
		hd.output.output_amount = 0.01
		hd.coords.U_Offset = 42.0 / 360.0
		environmentMap = hd
		useEnvironmentMap = true
	) catch ()
	try (
		SceneExposureControl.exposureControl = Physical_Camera_Exposure_Control()
		sp SceneExposureControl.exposureControl #use_physical_camera_controls true
		sp SceneExposureControl.exposureControl #global_ev 4.5
	) catch ()
	renderWidth = 1920
	renderHeight = 1080
	enableSceneRedraw()
	try (viewport.setCamera cams[1]) catch ()
	try (displaySafeFrames = true) catch ()
	redrawViews()
	local outFile = scriptDir + "Owns_Cafe.max"
	saveMaxFile outFile quiet:true
	local secs = (timeStamp() - t0) / 1000.0
	format "Owns Cafe: % objects built, % failed, saved to % in % s\n" nObj nFail outFile secs
	messageBox ("Owns Cafe model built.\n\n" + (nObj as string) + " objects, " + (nFail as string) + " failed.\nSaved: " + outFile + "\n\nCameras are on layer 14_Cameras.") title:"Owns Cafe"
)
if queryBox "Build the Owns Cafe 3D model?\n\nThis starts a new scene (you'll be asked to save the current one first)." title:"Owns Cafe" do (
	if checkForSave() do (
		resetMaxFile #noPrompt
		buildAll()
	)
)
)
