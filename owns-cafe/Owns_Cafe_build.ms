	defMat "floor" (color 236 231 222) 0.18 0 "floor_tile.jpg" 120 "" 0 0.3 0 undefined
	defMat "glass" (color 235 245 243) 0 0 undefined 100 "glass" 0 0 0 undefined
	defMat "glass_satin" (color 236 232 224) 0.35 0 undefined 100 "satin" 7 0 0 undefined
	defMat "lacquer_white" (color 241 239 234) 0.3 0 undefined 100 "" 0 0 0 undefined
	defMat "leaves" (color 96 110 74) 0.5 0 undefined 100 "leaf" 0 0 0 undefined
	defMat "leaves_b" (color 128 136 104) 0.5 0 undefined 100 "leaf" 0 0 0 undefined
	defMat "led_cool" (color 243 246 255) 0.5 0 undefined 100 "emit" 1500 0 0 undefined
	defMat "led_halo" (color 255 200 135) 0.5 0 undefined 100 "emit" 9000 0 0 undefined
	defMat "led_hidden" (color 255 196 128) 0.5 0 undefined 100 "emit" 12000 0 0 undefined
	defMat "led_warm" (color 255 196 128) 0.5 0 undefined 100 "emit" 6000 0 0 undefined
	defMat "metal_black" (color 20 20 20) 0.38 0.7 undefined 100 "" 0 0 0 undefined
	defMat "mirror" (color 240 240 240) 0.02 1 undefined 100 "" 0 0 0 undefined
	defMat "oak" (color 196 160 118) 0.45 0 "oak.jpg" 100 "" 0 0 0.15 undefined
	defMat "paint_white" (color 222 222 216) 0.6 0 undefined 100 "" 0 0 0 undefined
	defMat "paint_yellow" (color 201 162 39) 0.7 0 undefined 100 "" 0 0 0 undefined
	defMat "paper" (color 232 224 210) 0.8 0 undefined 100 "" 0 0 0 undefined
	defMat "pastry" (color 176 116 58) 0.45 0 undefined 100 "" 0 0 0.6 undefined
	defMat "pastry_dark" (color 92 56 32) 0.55 0 undefined 100 "" 0 0 0.6 undefined
	defMat "paver" (color 176 169 157) 0.5 0 "paver.jpg" 120 "" 0 0 0.3 undefined
	defMat "planter" (color 226 219 207) 0.75 0 undefined 100 "" 0 0 0 undefined
	defMat "plaster_ext" (color 186 174 158) 0.9 0 "plaster.jpg" 600 "" 0 0 0 undefined
	defMat "plaster_sand" (color 214 194 166) 0.85 0 undefined 100 "" 0 0 0 undefined
	defMat "plaster_white" (color 239 236 230) 0.85 0 undefined 100 "" 0 0 0 undefined
	defMat "quartz" (color 244 241 236) 0.12 0 undefined 100 "" 0 0.4 0 undefined
	defMat "screen" (color 60 80 105) 0.05 0 undefined 100 "emit" 60 0 0 undefined
	defMat "shop_glow" (color 255 226 190) 0.5 0 undefined 100 "emit" 14 0 0 undefined
	defMat "sign_glow" (color 255 232 196) 0.5 0 undefined 100 "emit" 500 0 0 undefined
	defMat "soil" (color 58 43 31) 1 0 undefined 100 "" 0 0 0 undefined
	defMat "steel" (color 205 205 205) 0.25 1 undefined 100 "" 0 0 0 undefined
	defMat "stone" (color 222 210 190) 0.55 0 "travertine.jpg" 360 "" 0 0 0.5 "travertine_bump.jpg"
	-- meshes
	mkMesh "Wall_Left_A" "01_Shell" "stone" #([123.25,278.8,580],[130.67,273.47,580],[130.69,273.45,580],[130.81,273.41,580],[130.87,273.4,580],[130.93,273.41,580],[130.98,273.44,580],[131.08,273.52,580],[131.1,273.54,580],[142.21,289,580],[142.22,289.03,580],[142.29,289.25,580],[142.3,289.29,580],[142.3,419.29,580],[142.3,419.32,580],[142.26,419.44,580],[142.24,419.49,580],[142.19,419.54,580],[142.14,419.56,580],[142.02,419.6,580],[141.99,419.6,580],[123.41,419.6,580],[123.38,419.6,580],[123.26,419.56,580],[123.21,419.54,580],[123.17,419.49,580],[123.14,419.44,580],[123.1,419.32,580],[123.1,419.29,580],[123.1,279.09,580],[123.1,279.06,580],[123.13,278.95,580],[123.15,278.9,580],[123.23,278.82,580],[123.12,278.64,579.95],[130.56,273.3,579.95],[130.61,273.27,579.95],[130.77,273.21,579.95],[130.88,273.2,579.95],[130.99,273.22,579.95],[131.09,273.26,579.95],[131.21,273.37,579.95],[131.25,273.41,579.95],[142.38,288.9,579.95],[142.41,288.96,579.95],[142.49,289.2,579.95],[142.5,289.27,579.95],[142.5,419.31,579.95],[142.49,419.36,579.95],[142.45,419.52,579.95],[142.4,419.62,579.95],[142.32,419.69,579.95],[142.22,419.75,579.95],[142.06,419.79,579.95],[142,419.8,579.95],[123.39,419.8,579.95],[123.34,419.79,579.95],[123.18,419.75,579.95],[123.08,419.69,579.95],[123,419.62,579.95],[122.95,419.52,579.95],[122.91,419.36,579.95],[122.9,419.31,579.95],[122.9,279.08,579.95],[122.91,279.03,579.95],[122.94,278.88,579.95],[122.99,278.79,579.95],[123.09,278.68,579.95],[123.03,278.53,579.8],[130.49,273.17,579.8],[130.55,273.14,579.8],[130.73,273.07,579.8],[130.88,273.05,579.8],[131.03,273.08,579.8],[131.16,273.14,579.8],[131.31,273.26,579.8],[131.37,273.32,579.8],[142.5,288.82,579.8],[142.54,288.9,579.8],[142.63,289.17,579.8],[142.65,289.26,579.8],[142.65,419.31,579.8],[142.64,419.39,579.8],[142.59,419.58,579.8],[142.51,419.71,579.8],[142.41,419.81,579.8],[142.28,419.89,579.8],[142.09,419.94,579.8],[142.01,419.95,579.8],[123.39,419.95,579.8],[123.31,419.94,579.8],[123.12,419.89,579.8],[122