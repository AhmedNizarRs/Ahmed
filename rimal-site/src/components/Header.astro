---
import { Image } from 'astro:assets';
import lockup from '../assets/brand/logo-lockup-light.png';
import type { Lang } from '../content/products';
import { flagship } from '../content/products';
import { getCopy } from '../content/copy';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getCopy(lang);
const home = lang === 'ar' ? '/' : '/en/';
const links = [
  ['#programs', t.nav.programs],
  ['#vault', t.nav.vault],
  ['#details', t.nav.details],
  ['#about', t.nav.about],
  ['#faq', t.nav.faq],
] as const;
const logoH = 44;
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={home}>
      <Image
        src={lockup}
        alt="RIMAL Interiors"
        height={logoH}
        width={Math.round((logoH * lockup.width) / lockup.height)}
        densities={[1, 2]}
        loading="eager"
      />
    </a>

    <nav class="nav" aria-label={lang === 'ar' ? 'أقسام الصفحة' : 'Page sections'}>
      {links.map(([href, label]) => <a href={href}>{label}</a>)}
    </nav>

    <div class="actions">
      <a class="lang" href={t.langSwitch.href} hreflang={t.langSwitch.hreflang} lang={t.langSwitch.hreflang}>
        <span class="lang-long">{t.langSwitch.label}</span><span class="lang-short" aria-hidden="true">{t.langSwitch.short}</span>
        <span class="sr-only lang-sr">{t.langSwitch.label}</span>
      </a>
      <a class="btn btn--buy head-buy" href={flagship.buyUrl} target="_blank" rel="noopener" data-buy="header">
        <span class="head-buy-label">{t.buyShort}</span>
        <span class="num" dir="ltr">${flagship.price}</span>
        <span class="sr-only">{t.newTab}</span>
      </a>
      <button class="menu-btn" type="button" popovertarget="site-menu" aria-label={t.menu}>
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <div id="site-menu" class="menu" popover>
    <div class="menu-top">
      <span class="label">{t.menu}</span>
      <button type="button" class="menu-close" popovertarget="site-menu" popovertargetaction="hide" aria-label={lang === 'ar' ? 'إغلاق' : 'Close'}>
        <Icon name="close" />
      </button>
    </div>
    <nav aria-label={t.menu}>
      {links.map(([href, label]) => <a href={href} data-close-menu>{label}</a>)}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset-inline: 0;
    inset-block-start: 0;
    z-index: 40;
    transition:
      background-color 300ms ease,
      border-color 300ms ease,
      backdrop-filter 300ms ease;
    border-block-end: 1px solid transparent;
  }
  :global(.scrolled) .site-header {
    background: rgb(21 16 12 / 0.82);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    border-block-end-color: var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-block-size: 4.5rem;
  }
  .brand {
    flex: none;
    display: block;
  }
  .brand :global(img) {
    block-size: 2.5rem;
    inline-size: auto;
  }
  .nav {
    display: none;
    gap: clamp(1.25rem, 2vw, 2.25rem);
  }
  .nav a {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-2);
    padding-block: 0.75rem;
    background: linear-gradient(currentColor, currentColor) no-repeat 50% 75% / 0 1px;
    transition:
      color 200ms,
      background-size 260ms var(--ease-out);
  }
  :lang(ar) .nav a {
    font-size: 0.9375rem;
    font-weight: 400;
    letter-spacing: 0;
  }
  .nav a:hover {
    color: var(--text);
    background-size: 100% 1px;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .lang {
    display: inline-grid;
    place-items: center;
    min-inline-size: 2.75rem;
    min-block-size: 2.75rem;
    padding-inline: 0.5rem;
    font-size: 0.875rem;
    text-decoration: none;
    color: var(--text);
    border-radius: 999px;
    transition: background-color 200ms;
  }
  .lang:hover {
    background: rgb(243 233 219 / 0.08);
  }
  .lang-long {
    display: none;
  }
  .head-buy {
    min-block-size: 2.75rem;
    padding-inline: 1rem;
    font-size: 0.6875rem;
    gap: 0.5rem;
  }
  :lang(ar) .head-buy {
    font-size: 0.9375rem;
  }
  .head-buy .num {
    letter-spacing: 0.04em;
  }
  .head-buy-label {
    display: none;
  }
  .menu-btn,
  .menu-close {
    display: inline-grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    cursor: pointer;
    border-radius: 999px;
  }
  .menu-btn :global(svg),
  .menu-close :global(svg) {
    inline-size: 1.375rem;
    block-size: 1.375rem;
  }

  /* mobile menu (native popover, no JS) */
  .menu {
    position: fixed;
    inset: 0;
    inline-size: 100%;
    block-size: 100dvh;
    max-inline-size: none;
    max-block-size: none;
    margin: 0;
    padding: 1rem var(--gutter) 2rem;
    border: 0;
    background: var(--bg);
    color: var(--text);
  }
  .menu-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-block-size: 2.5rem;
    margin-block-end: 2rem;
  }
  .menu nav {
    display: grid;
  }
  .menu nav a {
    font-family: var(--f-display);
    font-size: 2rem;
    line-height: 1.2;
    padding-block: 0.875rem;
    border-block-end: 1px solid var(--line);
    text-decoration: none;
  }
  :lang(en) .menu nav a {
    text-transform: uppercase;
  }
  :lang(ar) .menu nav a {
    font-weight: 300;
  }
  @media (prefers-reduced-motion: no-preference) {
    .menu:popover-open {
      animation: menu-in 320ms var(--ease-out);
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  @media (min-width: 40rem) {
    .head-buy-label {
      display: inline;
    }
  }
  @media (min-width: 64rem) {
    .nav {
      display: flex;
    }
    .menu-btn {
      display: none;
    }
    .lang-long {
      display: inline;
    }
    .lang-short,
    .lang-sr {
      display: none;
    }
    .lang {
      padding-inline: 1rem;
    }
    .brand :global(img) {
      block-size: 2.75rem;
    }
  }
</style>
