---
import type { Lang } from '../content/products';
import { getCopy } from '../content/copy';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getCopy(lang);
---

<section id="features" class="features" aria-label={lang === 'ar' ? 'أرقام الحزمة' : 'The Vault in numbers'}>
  <ul class="wrap row">
    {
      t.features.map((f) => (
        <li class="item">
          <Icon name={f.icon as 'block'} class="ico" />
          <span class="fig num" dir="ltr">{f.fig}</span>
          <span class="lab">{f.label}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .features {
    background: var(--bg);
    border-block: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .item {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.375rem;
    padding: 1.5rem 0.75rem;
    text-align: center;
  }
  .item:nth-child(odd) {
    border-inline-end: 1px solid var(--line);
  }
  .item:nth-child(-n + 2) {
    border-block-end: 1px solid var(--line);
  }
  .item :global(.ico) {
    inline-size: 1.5rem;
    block-size: 1.5rem;
    color: var(--gold);
    margin-block-end: 0.25rem;
  }
  .fig {
    font-family: var(--f-display);
    font-size: var(--step-2);
    line-height: 1.1;
    letter-spacing: 0.02em;
  }
  :lang(ar) .fig {
    font-family: 'Marcellus', Georgia, serif;
  }
  .lab {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-2);
  }
  :lang(ar) .lab {
    text-transform: none;
    font-size: 0.875rem;
    font-weight: 400;
    letter-spacing: 0;
  }
  @media (min-width: 52rem) {
    .row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      padding-block: 0.5rem;
    }
    .item {
      padding-block: 2rem;
      border: 0 !important;
    }
    .item + .item {
      border-inline-start: 1px solid var(--line) !important;
    }
  }
</style>
