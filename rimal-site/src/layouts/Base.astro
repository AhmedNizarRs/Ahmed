---
import '../styles/global.css';
import type { Lang } from '../content/products';
import { flagship } from '../content/products';
import { getCopy } from '../content/copy';
import { BRAND, INSTAGRAM_URL, SITE_URL } from '../config';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getCopy(lang);
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const paths = { ar: '/', en: '/en/' } as const;
const canonical = new URL(paths[lang], SITE_URL).href;
const ogImage = new URL(t.meta.ogImage, SITE_URL).href;

const preloads =
  lang === 'ar'
    ? ['/fonts/ibm-plex-sans-arabic-arabic-300-normal.woff2']
    : ['/fonts/marcellus-latin-400-normal.woff2', '/fonts/ibm-plex-sans-arabic-latin-400-normal.woff2'];

const sheetsText = flagship.sheets!
  .map((s) => `${s.programName}: ${/\d/.test(s.figure) ? `${s.figure} ` : ''}${s.figureLabel[lang]}`)
  .join(' · ');

// Product schema for the Vault. No ratings or reviews: there are none to show yet.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#org`,
      name: BRAND.name,
      alternateName: BRAND.nameAr,
      url: SITE_URL,
      logo: new URL('/icon-512.png', SITE_URL).href,
      founder: { '@type': 'Person', name: BRAND.owner.en },
      sameAs: [INSTAGRAM_URL],
    },
    {
      '@type': 'Product',
      '@id': `${canonical}#vault`,
      name: flagship.name[lang],
      alternateName: flagship.name[lang === 'ar' ? 'en' : 'ar'],
      description: `${flagship.tagline[lang]} ${sheetsText}`,
      image: ogImage,
      brand: { '@type': 'Brand', name: BRAND.name },
      category: 'Digital design assets',
      offers: {
        '@type': 'Offer',
        price: flagship.price!.toFixed(2),
        priceCurrency: 'USD',
        availability: 'https://schema.org/InStock',
        url: flagship.buyUrl,
        seller: { '@id': `${SITE_URL}/#org` },
      },
    },
  ],
};
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ar" href={new URL('/', SITE_URL).href} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', SITE_URL).href} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', SITE_URL).href} />
    <meta name="theme-color" content="#15100c" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {preloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_AE' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_AE'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t.meta.title} />
    <meta name="twitter:description" content={t.meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      document.documentElement.classList.add('js');
      // Safety net: if the main script never runs, show everything anyway.
      setTimeout(function () {
        if (!document.documentElement.classList.contains('js-ready')) document.documentElement.classList.remove('js');
      }, 2500);
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <slot />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
