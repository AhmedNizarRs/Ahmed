 "vo": [
  {
   "id": "L1",
   "text": "أكثر شي يضيّع وقت المعماري، مو التصميم نفسه.",
   "from": 0.35,
   "to": 3.65
  },
  {
   "id": "L2",
   "text": "البحث عن الأدوات.",
   "from": 3.9,
   "to": 5.3
  },
  {
   "id": "L3",
   "text": "تخيّل لو كلها عندك من البداية.",
   "from": 5.75,
   "to": 8.05
  },
  {
   "id": "L4",
   "text": "هاي هي حزمة المهندس المعماري الشاملة.",
   "from": 8.4,
   "to": 11.2
  },
  {
   "id": "L5",
   "text": "إذا شغلك على ريفيت، مكتبة فاميليز بحجم ستة وعشرين جيجابايت.",
   "from": 12.2,
   "to": 16.8
  },
  {
   "id": "L6",
   "text": "لأوتوكاد، أكثر من ثلاثة آلاف بلوك ذكي، تتحكم بأبعادها خلال ثواني.",
   "from": 17.3,
   "to": 22.5
  },
  {
   "id": "L7",
   "text": "وفوقها، أكثر من ستة آلاف بلوك إضافي.",
   "from": 23.0,
   "to": 26.0
  },
  {
   "id": "L8",
   "text": "لسكتش أب، أكثر من ثلاثين إضافة احترافية،",
   "from": 26.5,
   "to": 29.5
  },
  {
   "id": "L9",
   "text": "ومن ضمنها مولّد المطابخ.",
   "from": 29.8,
   "to": 31.7
  },
  {
   "id": "L10",
   "text": "ولثري دي ماكس، سكربتات تولّد النوافذ والأبواب والمطابخ.",
   "from": 32.3,
   "to": 36.5
  },
  {
   "id": "L11",
   "text": "وحتى الذكاء الاصطناعي، أكثر من خمسة آلاف برومت جاهز.",
   "from": 37.4,
   "to": 41.4
  },
  {
   "id": "L12",
   "text": "خلّي أدواتك كلها بمكان واحد.",
   "from": 41.85,
   "to": 44.15
  },
  {
   "id": "L13",
   "text": "وكم رح تدفع مقابل كل هذا؟",
   "from": 44.5,
   "to": 46.6
  },
  {
   "id": "L14",
   "text": "خمسة وعشرين دولار فقط.",
   "from": 47.4,
   "to": 49.4
  },
  {
   "id": "L15",
   "text": "اكتب كلمة حزمة بالتعليقات، ونرسل لك الرابط.",
   "from": 50.1,
   "to": 53.5
  }
 ],
