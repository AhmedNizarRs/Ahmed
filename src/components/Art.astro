---
// Line drawings that stand in for each product on its specimen card.
// Drawn in the brand's ink and gold; purely illustrative.
interface Props {
  kind: 'revit' | 'autocad' | 'max';
  class?: string;
}
const { kind, class: className } = Astro.props;
---

<svg
  class:list={['art', className]}
  viewBox="0 0 320 220"
  aria-hidden="true"
  focusable="false"
  direction="ltr"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {
    kind === 'autocad' && (
      <g>
        <g class="art-grid">
          {Array.from({ length: 15 }, (_, i) => (
            <line x1={20 + i * 20} y1="10" x2={20 + i * 20} y2="210" />
          ))}
          {Array.from({ length: 10 }, (_, i) => (
            <line x1="10" y1={20 + i * 20} x2="310" y2={20 + i * 20} />
          ))}
        </g>
        {/* rug */}
        <rect class="art-thin" x="34" y="24" width="186" height="136" stroke-dasharray="4 4" />
        {/* three-seat sofa */}
        <g class="art-ink">
          <rect x="48" y="32" width="150" height="46" rx="4" />
          <line x1="48" y1="44" x2="198" y2="44" />
          <rect x="48" y="44" width="12" height="34" rx="2" />
          <rect x="186" y="44" width="12" height="34" rx="2" />
          <line x1="102" y1="44" x2="102" y2="78" />
          <line x1="144" y1="44" x2="144" y2="78" />
        </g>
        {/* coffee table */}
        <rect class="art-ink" x="88" y="96" width="70" height="36" rx="3" />
        <circle class="art-thin" cx="104" cy="114" r="6" />
        {/* armchair */}
        <g class="art-ink">
          <rect x="232" y="88" width="50" height="50" rx="5" />
          <line x1="272" y1="88" x2="272" y2="138" />
          <rect x="236" y="88" width="46" height="8" rx="2" />
          <rect x="236" y="130" width="46" height="8" rx="2" />
        </g>
        {/* plant */}
        <g class="art-thin">
          <circle cx="262" cy="42" r="16" />
          <path d="M262 26v32M246 42h32M251 31l22 22M273 31l-22 22" />
        </g>
        {/* dimension */}
        <g class="art-gold">
          <line x1="48" y1="182" x2="198" y2="182" />
          <line x1="48" y1="176" x2="48" y2="188" />
          <line x1="198" y1="176" x2="198" y2="188" />
          <line x1="44" y1="186" x2="52" y2="178" />
          <line x1="194" y1="186" x2="202" y2="178" />
        </g>
        <text class="art-dim" x="123" y="176" text-anchor="middle">2400</text>
      </g>
    )
  }
  {
    kind === 'revit' && (
      <g>
        <line class="art-ink" x1="16" y1="192" x2="304" y2="192" />
        <g class="art-hatch">
          {Array.from({ length: 29 }, (_, i) => (
            <line x1={20 + i * 10} y1="192" x2={12 + i * 10} y2="200" />
          ))}
        </g>
        {/* door family */}
        <g class="art-ink">
          <rect x="30" y="52" width="66" height="140" />
          <rect x="38" y="60" width="50" height="124" />
          <rect x="46" y="70" width="34" height="46" />
          <rect x="46" y="128" width="34" height="46" />
          <line x1="82" y1="122" x2="88" y2="122" />
        </g>
        {/* window family */}
        <g class="art-ink">
          <rect x="120" y="70" width="76" height="84" />
          <rect x="126" y="76" width="64" height="72" />
          <line x1="158" y1="76" x2="158" y2="148" />
          <line x1="126" y1="112" x2="190" y2="112" />
          <line x1="114" y1="154" x2="202" y2="154" />
        </g>
        {/* armchair family */}
        <g class="art-ink">
          <path d="M222 192v-14M288 192v-14" />
          <path d="M218 178h74v-26a6 6 0 0 0-6-6h-4v18h-54v-18h-4a6 6 0 0 0-6 6z" />
          <path d="M228 164v-40a8 8 0 0 1 8-8h38a8 8 0 0 1 8 8v40" />
        </g>
        {/* pendant family */}
        <g class="art-ink">
          <line x1="255" y1="14" x2="255" y2="54" />
          <path d="M240 72l6-18h18l6 18z" />
        </g>
        {/* family tags */}
        <g class="art-gold">
          <line x1="63" y1="52" x2="63" y2="30" />
          <line x1="158" y1="70" x2="158" y2="30" />
          <line x1="270" y1="63" x2="292" y2="44" />
          <rect class="art-tag" x="45" y="16" width="36" height="16" rx="8" />
          <rect class="art-tag" x="140" y="16" width="36" height="16" rx="8" />
          <rect class="art-tag" x="274" y="30" width="36" height="16" rx="8" />
        </g>
        <text class="art-dim" x="63" y="27.5" text-anchor="middle">D-01</text>
        <text class="art-dim" x="158" y="27.5" text-anchor="middle">W-02</text>
        <text class="art-dim" x="292" y="41.5" text-anchor="middle">L-03</text>
      </g>
    )
  }
  {
    kind === 'max' && (
      <g>
        {/* viewport frame */}
        <rect class="art-thin" x="12" y="12" width="210" height="196" rx="3" />
        <text class="art-dim" x="20" y="26">[+] [Perspective]</text>
        <g class="art-grid">
          <path d="M30 170l88-40 88 40-88 40z" />
          <path d="M52 160l88 40M74 150l88 40M96 140l88 40M52 180l88-40M74 190l88-40M96 200l88-40" />
        </g>
        {/* subdivided box */}
        <g class="art-ink">
          <path d="M72 138V82l46-22 46 22v56l-46 22z" />
          <path d="M72 82l46 22 46-22M118 104v56" />
          <path class="art-thin" d="M87 89v56M102 96v56M133 97v56M149 89v56M72 101l46 22 46-22M72 120l46 22 46-22M87 75l46 22M102 68l46 22M149 75l-46 22M133 68l-46 22" />
        </g>
        {/* transform gizmo */}
        <g class="art-gold art-gizmo">
          <line x1="118" y1="104" x2="118" y2="44" />
          <path d="M113 52l5-10 5 10" />
          <line x1="118" y1="104" x2="170" y2="128" />
          <path d="M160 128l12 1-6-10" />
          <line x1="118" y1="104" x2="66" y2="128" />
          <path d="M76 128l-12 1 6-10" />
        </g>
        {/* script rollout */}
        <g class="art-thin">
          <rect x="234" y="12" width="74" height="196" rx="3" />
          <line x1="234" y1="32" x2="308" y2="32" />
        </g>
        <g class="art-ink">
          <rect x="242" y="44" width="58" height="16" rx="2" />
          <rect x="242" y="68" width="58" height="16" rx="2" />
          <rect x="242" y="92" width="58" height="16" rx="2" />
          <rect x="242" y="116" width="58" height="16" rx="2" />
        </g>
        <g class="art-gold">
          <rect class="art-tag" x="242" y="148" width="58" height="16" rx="2" />
          <line x1="242" y1="180" x2="300" y2="180" />
          <circle class="art-tag" cx="262" cy="180" r="4" />
        </g>
        <path class="art-thin" d="M244 22h8M258 22h30" />
      </g>
    )
  }
</svg>

<style>
  .art {
    display: block;
    inline-size: 100%;
    block-size: auto;
    --art-ink: var(--ink);
  }
  .art :global(.art-ink) {
    stroke: var(--art-ink);
    stroke-width: 1.6;
  }
  .art :global(.art-thin) {
    stroke: var(--art-ink);
    stroke-width: 0.9;
    opacity: 0.65;
  }
  .art :global(.art-grid) {
    stroke: var(--gold-500);
    stroke-width: 0.6;
    opacity: 0.28;
  }
  .art :global(.art-hatch) {
    stroke: var(--art-ink);
    stroke-width: 0.8;
    opacity: 0.5;
  }
  .art :global(.art-gold) {
    stroke: var(--gold-600);
    stroke-width: 1.3;
  }
  .art :global(.art-tag) {
    fill: var(--paper);
  }
  .art :global(.art-dim) {
    fill: var(--gold-700);
    stroke: none;
    font: 600 9px/1 var(--font-text);
    letter-spacing: 0.04em;
    direction: ltr;
  }
</style>
