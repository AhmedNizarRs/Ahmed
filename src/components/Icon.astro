---
interface Props {
  name: 'external' | 'message' | 'instagram' | 'whatsapp' | 'link' | 'arrow-down';
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class:list={['icon', `icon-${name}`, className]}
  viewBox="0 0 24 24"
  width="20"
  height="20"
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {name === 'external' && <path d="M7 17 17 7M9 7h8v8" />}
  {name === 'arrow-down' && <path d="M12 5v14M6 13l6 6 6-6" />}
  {
    name === 'message' && (
      <path d="M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v9a1.5 1.5 0 0 1-1.5 1.5H9l-5 4z" />
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" />
      </>
    )
  }
  {
    name === 'whatsapp' && (
      <>
        <path d="M4 20l1.2-4.1A8 8 0 1 1 8.3 19z" />
        <path d="M9.2 8.6c.2-.5.5-.6.8-.6h.5c.2 0 .4.1.5.4l.7 1.6c.1.2 0 .5-.1.6l-.5.6c-.1.1-.1.3 0 .5.6 1 1.4 1.8 2.5 2.4.2.1.4.1.5 0l.6-.6c.2-.2.4-.2.6-.1l1.6.7c.3.1.4.3.4.5v.5c0 .3-.1.6-.6.8-.8.4-1.9.4-3.5-.4-1.5-.8-2.9-2.2-3.7-3.7-.7-1.4-.7-2.5-.3-3.2z" />
      </>
    )
  }
  {
    name === 'link' && (
      <path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" />
    )
  }
</svg>

<style>
  .icon {
    flex: none;
    inline-size: 1.15em;
    block-size: 1.15em;
  }
  /* Directional glyphs mirror in right-to-left layouts. */
  :global([dir='rtl']) .icon-external {
    transform: scaleX(-1);
  }
</style>
